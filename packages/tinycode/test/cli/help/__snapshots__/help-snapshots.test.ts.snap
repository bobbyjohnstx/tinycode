// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`tinycode CLI help-text snapshots every documented command emits stable help text: tinycode acp --help 1`] = `
"Performing one time database migration, may take a few minutes...
sqlite-migration:done
Database migration complete.
⠀                                ▄     
█▀▀█ █▀▀█ █▀▀█ █▀▀▄ █▀▀▀ █▀▀█ █▀▀█ █▀▀█
█  █ █  █ █▀▀▀ █  █ █    █  █ █  █ █▀▀▀
▀▀▀▀ █▀▀▀ ▀▀▀▀ ▀  ▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀

Commands:
  tinycode completion          generate shell completion script
  tinycode mcp                 manage MCP (Model Context Protocol) servers
  tinycode [project]           start opencode tui                                          [default]
  tinycode attach <url>        attach to a running tinycode server
  tinycode run [message..]     run opencode with a message
  tinycode debug               debugging and troubleshooting tools
  tinycode providers           manage AI providers and credentials                   [aliases: auth]
  tinycode agent               manage agents
  tinycode uninstall           uninstall opencode and remove all related files
  tinycode serve               starts a headless opencode server
  tinycode web                 start opencode server and open web interface
  tinycode models [provider]   list all available models
  tinycode export [sessionID]  export session data as JSON
  tinycode import <file>       import session data from JSON file or URL
  tinycode session             manage sessions
  tinycode plugin <module>     install plugin and update config                      [aliases: plug]
  tinycode db                  database tools

Positionals:
  project  path to start opencode in                                                        [string]

Options:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level                  [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                          [boolean]
      --port         port to listen on                                         [number] [default: 0]
      --hostname     hostname to listen on                           [string] [default: "127.0.0.1"]
      --mdns         enable mDNS service discovery (defaults hostname to 0.0.0.0)
                                                                          [boolean] [default: false]
      --mdns-domain  custom domain name for mDNS service (default: opencode.local)
                                                                [string] [default: "opencode.local"]
      --cors         additional domains to allow for CORS                      [array] [default: []]
  -m, --model        model to use in the format of provider/model                           [string]
  -c, --continue     continue the last session                                             [boolean]
  -s, --session      session id to continue                                                 [string]
      --fork         fork the session when continuing (use with --continue or --session)   [boolean]
      --prompt       prompt to use                                                          [string]
      --agent        agent to use                                                           [string]"
`;

exports[`tinycode CLI help-text snapshots every documented command emits stable help text: tinycode mcp --help 1`] = `
"tinycode mcp

manage MCP (Model Context Protocol) servers

Commands:
  tinycode mcp add            add an MCP server
  tinycode mcp list           list MCP servers and their status                        [aliases: ls]
  tinycode mcp auth [name]    authenticate with an OAuth-enabled MCP server
  tinycode mcp logout [name]  remove OAuth credentials for an MCP server
  tinycode mcp debug <name>   debug OAuth connection for an MCP server

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

exports[`tinycode CLI help-text snapshots every documented command emits stable help text: tinycode attach --help 1`] = `
"tinycode attach <url>

attach to a running tinycode server

Positionals:
  url  http://localhost:4096                                                     [string] [required]

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]
      --dir         directory to run in                                                     [string]
  -c, --continue    continue the last session                                              [boolean]
  -s, --session     session id to continue                                                  [string]
      --fork        fork the session when continuing (use with --continue or --session)    [boolean]
  -p, --password    basic auth password (defaults to OPENCODE_SERVER_PASSWORD)              [string]
  -u, --username    basic auth username (defaults to OPENCODE_SERVER_USERNAME or 'opencode')[string]"
`;

exports[`tinycode CLI help-text snapshots every documented command emits stable help text: tinycode run --help 1`] = `
"tinycode run [message..]

run opencode with a message

Positionals:
  message  message to send                                                     [array] [default: []]

Options:
  -h, --help                          show help                                            [boolean]
  -v, --version                       show version number                                  [boolean]
      --print-logs                    print logs to stderr                                 [boolean]
      --log-level                     log level [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure                          run without external plugins                         [boolean]
      --command                       the command to run, use message for args              [string]
  -c, --continue                      continue the last session                            [boolean]
  -s, --session                       session id to continue                                [string]
      --fork                          fork the session before continuing (requires --continue or
                                      --session)                                           [boolean]
      --share                         share the session                                    [boolean]
  -m, --model                         model to use in the format of provider/model          [string]
      --agent                         agent to use                                          [string]
      --format                        format: default (formatted) or json (raw JSON events)
                                          [string] [choices: "default", "json"] [default: "default"]
  -f, --file                          file(s) to attach to message                           [array]
      --title                         title for the session (uses truncated prompt if no value
                                      provided)                                             [string]
      --attach                        attach to a running tinycode server (e.g.,
                                      http://localhost:4096)                                [string]
  -p, --password                      basic auth password (defaults to OPENCODE_SERVER_PASSWORD)
                                                                                            [string]
  -u, --username                      basic auth username (defaults to OPENCODE_SERVER_USERNAME or
                                      'opencode')                                           [string]
      --dir                           directory to run in, path on remote server if attaching
                                                                                            [string]
      --port                          port for the local server (defaults to random port if no value
                                      provided)                                             [number]
      --variant                       model variant (provider-specific reasoning effort, e.g., high,
                                      max, minimal)                                         [string]
      --thinking                      show thinking blocks                                 [boolean]
      --replay                        replay visible session history on interactive resume
                                                                          [boolean] [default: false]
      --replay-limit                  cap visible interactive replay to the newest N messages
                                                                                            [number]
  -i, --interactive                   run in direct interactive split-footer mode
                                                                          [boolean] [default: false]
      --dangerously-skip-permissions  auto-approve permissions that are not explicitly denied
                                      (dangerous!)                        [boolean] [default: false]
      --demo                          enable direct interactive demo slash commands; pass one as the
                                      message to run it immediately       [boolean] [default: false]"
`;

exports[`tinycode CLI help-text snapshots every documented command emits stable help text: tinycode debug --help 1`] = `
"tinycode debug

debugging and troubleshooting tools

Commands:
  tinycode debug config        show resolved configuration
  tinycode debug lsp           LSP debugging utilities
  tinycode debug rg            ripgrep debugging utilities
  tinycode debug file          file system debugging utilities
  tinycode debug scrap         list all known projects
  tinycode debug skill         list all available skills
  tinycode debug snapshot      snapshot debugging utilities
  tinycode debug startup       print startup timing
  tinycode debug agent <name>  show agent configuration details
  tinycode debug v2            debug v2 catalog and built-in plugins
  tinycode debug info          show debug information
  tinycode debug paths         show global paths (data, config, cache, state)
  tinycode debug wait          wait indefinitely (for debugging)

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

