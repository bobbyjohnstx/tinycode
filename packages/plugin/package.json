{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@tinycode/plugin",
  "version": "1.18.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "tsc"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tool": {
      "bun": "./src/tool.ts",
      "import": "./dist/tool.js",
      "types": "./dist/tool.d.ts"
    },
    "./tui": {
      "bun": "./src/tui.ts",
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    },
    "./test": {
      "bun": "./src/test.ts",
      "import": "./dist/test.js",
      "types": "./dist/test.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@tinycode/sdk": "workspace:*",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.2.16",
    "@opentui/keymap": ">=0.2.16",
    "@opentui/solid": ">=0.2.16"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/keymap": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/solid": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
