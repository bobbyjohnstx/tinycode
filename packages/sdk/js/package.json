{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@tinycode/sdk",
  "version": "1.20.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "bun ./script/build.ts"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "bun": "./src/client.ts",
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./server": {
      "bun": "./src/server.ts",
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./v2": {
      "bun": "./src/v2/index.ts",
      "import": "./dist/v2/index.js",
      "types": "./dist/v2/index.d.ts"
    },
    "./v2/client": {
      "bun": "./src/v2/client.ts",
      "import": "./dist/v2/client.js",
      "types": "./dist/v2/client.d.ts"
    },
    "./v2/gen/client": {
      "bun": "./src/v2/gen/client/index.ts",
      "import": "./dist/v2/gen/client/index.js",
      "types": "./dist/v2/gen/client/index.d.ts"
    },
    "./v2/server": {
      "bun": "./src/v2/server.ts",
      "import": "./dist/v2/server.js",
      "types": "./dist/v2/server.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@hey-api/openapi-ts": "0.90.10",
    "@tsconfig/node22": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "cross-spawn": "catalog:"
  }
}
